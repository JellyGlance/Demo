# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
# Password for the demo login. Visitors are signed in automatically and never see it.
DEMO_PASSWORD=

# Optional
DEMO_PORT=8080
TZ=Europe/London
JELLYGLANCE_TAG=latest
DEMO_SITE_URL=https://jellyglance.com
DEMO_RESET_HOUR=4
DEMO_HISTORY_DAYS=365
DEMO_MAX_SESSIONS=4
# true when a reverse proxy (Caddy, Cloudflare…) sits in front of the gateway
GATEWAY_BEHIND_PROXY=false
# Change for a different set of users, titles and history.
DEMO_SEED=jellyglance-demo
