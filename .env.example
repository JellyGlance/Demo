# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
# Password for the demo login. Visitors are signed in automatically and never see it.
DEMO_PASSWORD=
# Real film and TV titles, posters and episodes. Free key from https://www.themoviedb.org/settings/api
# (the v3 API key or the v4 read access token both work). Without it the demo uses generated titles.
TMDB_API_KEY=

# Optional
DEMO_PORT=8080
TZ=Europe/London
JELLYGLANCE_TAG=latest
DEMO_SITE_URL=https://jellyglance.com
# Rebuild history and integrations every N hours (on the hour, from midnight)
DEMO_RESET_EVERY_HOURS=4
# Demo image tag pulled by docker compose (built and pushed by GitHub Actions)
DEMO_IMAGE_TAG=latest
DEMO_HISTORY_DAYS=365
DEMO_MAX_SESSIONS=4
# true when a reverse proxy (Caddy, Cloudflare…) sits in front of the gateway
GATEWAY_BEHIND_PROXY=false
# Change for a different set of users, titles and history.
DEMO_SEED=jellyglance-demo
